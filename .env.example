# ==================================
# LLM Provider Configuration
# ==================================
# Pilih provider LLM yang ingin digunakan:
#   - "ollama"  : Menggunakan LLM lokal via Ollama (gratis, tapi butuh RAM & GPU)
#   - "gemini"  : Menggunakan Google Gemini API (cepat, butuh API Key)
LLM_PROVIDER=gemini

# ==================================
# Google Gemini API Key
# ==================================
# Dapatkan API Key gratis di: https://aistudio.google.com/apikey
# Wajib diisi jika LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ==================================
# Telegram Bot Token
# ==================================
# Dapatkan token dari @BotFather di Telegram
# Wajib diisi jika ingin menjalankan Telegram Bot (main.py)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ==================================
# OpenAI API Key (Opsional)
# ==================================
# Jika ingin menggunakan OpenAI sebagai LLM provider
# OPENAI_API_KEY=your_openai_api_key_here

# ==================================
# Celery / Redis Queue Configuration
# ==================================
# Broker & result backend untuk antrian query (Web Dashboard + Telegram Bot
# masuk ke antrian yang sama, diproses satu per satu oleh Celery worker).
# Butuh Redis server berjalan di alamat ini (via Docker/WSL/Memurai di Windows).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
